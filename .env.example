# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB URI here (e.g. mongodb://localhost:27017/afridi_rangoona or MongoDB Atlas SRV)
# If left empty or unreachable in development, an embedded in-memory MongoDB will auto-initialize!
MONGODB_URI=mongodb://localhost:27017/afridi_rangoona

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_key_here

# Frontend Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Payment Provider - Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# Payment Provider - Safepay Sandbox (optional adapter)
SAFEPAY_API_KEY=sec_placeholder_safepay_key
SAFEPAY_WEBHOOK_SECRET=safepay_webhook_secret_placeholder
SAFEPAY_ENVIRONMENT=sandbox

# Default Store Currency & Shipping Settings
CURRENCY=PKR
DEFAULT_SHIPPING_FEE=250
FREE_SHIPPING_THRESHOLD=5000
